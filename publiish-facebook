const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers":
    "authorization, x-client-info, apikey, content-type",
};

Deno.serve(async (req) => {
  // El navegador envía esta petición antes del POST real
  if (req.method === "OPTIONS") {
    return new Response("ok", {
      headers: corsHeaders,
    });
  }

  try {
    const { imageUrl, message } = await req.json();

    if (!imageUrl) {
      return new Response(
        JSON.stringify({
          ok: false,
          error: "Falta imageUrl",
        }),
        {
          status: 400,
          headers: {
            ...corsHeaders,
            "Content-Type": "application/json",
          },
        },
      );
    }

    const pageAccessToken = Deno.env.get(
      "META_PAGE_ACCESS_TOKEN",
    );

    if (!pageAccessToken) {
      return new Response(
        JSON.stringify({
          ok: false,
          error: "No se encontró META_PAGE_ACCESS_TOKEN",
        }),
        {
          status: 500,
          headers: {
            ...corsHeaders,
            "Content-Type": "application/json",
          },
        },
      );
    }

    const pageId = "pageID";

    const formData = new URLSearchParams();
    formData.append("url", imageUrl);
    formData.append("published", "true");
    formData.append("access_token", pageAccessToken);

    if (message) {
      formData.append("caption", message);
    }

    const metaResponse = await fetch(
      `https://graph.facebook.com/v25.0/${pageId}/photos`,
      {
        method: "POST",
        headers: {
          "Content-Type":
            "application/x-www-form-urlencoded",
        },
        body: formData,
      },
    );

    const metaData = await metaResponse.json();

    if (!metaResponse.ok) {
      return new Response(
        JSON.stringify({
          ok: false,
          error: metaData,
        }),
        {
          status: metaResponse.status,
          headers: {
            ...corsHeaders,
            "Content-Type": "application/json",
          },
        },
      );
    }

    return new Response(
      JSON.stringify({
        ok: true,
        result: metaData,
      }),
      {
        status: 200,
        headers: {
          ...corsHeaders,
          "Content-Type": "application/json",
        },
      },
    );
  } catch (error) {
    return new Response(
      JSON.stringify({
        ok: false,
        error:
          error instanceof Error
            ? error.message
            : "Error inesperado",
      }),
      {
        status: 500,
        headers: {
          ...corsHeaders,
          "Content-Type": "application/json",
        },
      },
    );
  }
});